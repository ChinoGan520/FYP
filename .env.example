# Copy to ignored instance/.env for local development; never add real values here.
# Use the existing Firebase project's actual project ID, not its display name.
DATA_BACKEND=firestore
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local credential option: keep this downloaded JSON OUTSIDE the repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/irice-service-account.json

# Vercel: set FIREBASE_SERVICE_ACCOUNT_JSON to the COMPLETE service-account JSON
# in secure project environment settings. Do not put its value in this example.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Generate a strong random value locally, then keep it stable across deployments.
# Example generator: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# Local HTTP: 0. Vercel / other HTTPS deployment: 1.
COOKIE_SECURE=0

# Local emulator only: use demo-irice-test, and never copy these into Vercel.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-irice-test
# No service-account key is needed when explicitly using the local emulator.

# Explicit local/test document-store substitute only; never use on Vercel.
# DATA_BACKEND=sqlite
# SQLITE_PATH=instance/local-documents.sqlite3
